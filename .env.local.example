# Point the browser at the deployed API, with no trailing slash.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8099

# Which tenant this deployment serves. Must match a slug in agentctl.tenant.
NEXT_PUBLIC_TENANT=alwaha

# Only for a domain you control per tenant (alwaha.agent.example.com). Leave unset on
# Vercel/Railway domains — the deployment name would be read as the tenant slug.
# NEXT_PUBLIC_TENANT_FROM_SUBDOMAIN=true

# The deployed origin, so share-preview images resolve to absolute URLs.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
